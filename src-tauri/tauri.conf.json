{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxLocal",
  "version": "0.1.0",
  "identifier": "com.voxlocal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoxLocal",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Private local voice reading",
    "longDescription": "Record your voice and listen to documents with fully local AI on macOS."
    ,"resources": ["../backend/voxlocal_engine.py", "../vendor/uv", "../assets/public-voice-previews"]
  }
}
